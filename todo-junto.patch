+print(f"Errores durante el escaneo: {len(errores)}", errores[:3])
+print(f"Señales devueltas: {len(df)} | columnas: {list(df.columns)}")
+print(df[["symbol", "category", "direction", "strength", "agreement", "regime"]].to_string(index=False))
